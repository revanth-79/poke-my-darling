rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(pid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pid)).data.members; }

    // Which room an account belongs to. Only that account can see or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // One-time invite codes. You can look one up only if you already know the code.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }

    // A room for two. The creator is the first member; one more person can join, then it is closed.
    match /pairs/{pid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && resource.data.members.size() == 1
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // Games, chat and names: only the two members can read or write.
      match /app/{docId} { allow read, write: if isMember(pid); }
      match /games/{docId} { allow read, write: if isMember(pid); }
      match /chat/{docId} { allow read, write: if isMember(pid); }
    }
  }
}
